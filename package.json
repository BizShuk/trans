{
  "name": "trans",
  "version": "0.0.0",
  "private": true,
  "description": "多引擎文字與文件翻譯工具",
  "scripts": {
    "dev": "npx npm-run-all --parallel dev:*",
    "dev:go": "go run . --help",
    "test": "npx npm-run-all --parallel test:*",
    "test:go": "go test ./...",
    "build": "npx npm-run-all --parallel build:*",
    "build:go": "go build -o translate .",
    "lint": "npx npm-run-all --parallel lint:*",
    "lint:go": "go fmt ./... && go vet ./...",
    "clean": "npx npm-run-all --parallel clean:*",
    "clean:go": "rm -f translate",
    "run:setup": "./scripts/run.sh"
  }
}
